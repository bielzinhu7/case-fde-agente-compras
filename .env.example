# Copie para .env e preencha. O .env não entra no git.
OPENROUTER_API_KEY=
# Testado com este modelo. Outro modelo precisa aceitar ferramentas (tools) com tool_choice=required.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Opcionais (valores padrão):
# CHAT_PORT=3000            porta do chat no host
# API_PORT=8000             porta da API no host
# MCP_PUBLIC_PORT=8001      porta do servidor MCP no host
# DUMMYJSON_TIMEOUT=5       segundos até considerar a DummyJSON fora do ar
